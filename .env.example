# Copy to .env.local and fill in.
#
# The contact and volunteer forms do not need any configuration. They validate
# in the browser and then open the visitor's own email app with the details
# filled in, addressed to site.email in src/lib/site.ts.

# Firebase web config, from Project settings > Your apps in the Firebase
# console. These are public identifiers, not credentials, and Firestore access
# is controlled by firestore.rules. Without them the forms still open an email,
# they just skip the Firestore archive.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
